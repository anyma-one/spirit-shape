# Copy to .env.local (gitignored) for local dev, or set in your serverless host's
# dashboard for production. The dev API runner (dev/vite-plugin-dev-api.ts) loads
# these into process.env so the Vercel-style api/*.ts handlers work under
# `npm run dev` (they otherwise only run on a deploy).

# Phase 1/2 work WITHOUT this key (deterministic prose templates). The Deep Dive
# (Tier 3) pipeline — interview, extraction, synthesis, report — REQUIRES it.
ANTHROPIC_API_KEY=

# Closed-beta passcode for the Deep Dive. Every api/deepdive-* function rejects
# calls without it (401), and they ALL refuse (503) while it is unset — so set it
# in Vercel before expecting the Deep Dive to work. Share it with beta testers;
# change it here/in Vercel to revoke access (stored codes are then re-asked).
DEEPDIVE_PASSCODE=

# ---- Deep Dive (Tier 3) model config — the SINGLE SOURCE OF TRUTH for per-stage
# models. Set these here for local dev and in the Vercel dashboard for prod; a
# model change is a one-line edit here. Each api/deepdive-* function falls back to
# the same value in code if its var is unset, so behaviour is correct either way.
ANTHROPIC_DRIVER_MODEL=claude-opus-4-8
ANTHROPIC_EXTRACT_MODEL=claude-sonnet-4-6
ANTHROPIC_SYNTH_MODEL=claude-opus-4-8
ANTHROPIC_REPORT_MODEL=claude-opus-4-8

# Tiers 1/2 pre-written prose (unrelated to the Deep Dive).
# ANTHROPIC_PROSE_MODEL=claude-haiku-4-5-20251001

# Already used by the existing waitlist/log functions (set in Vercel for prod).
# Only needed locally to exercise those endpoints under npm run dev.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
